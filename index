<script>
// Redirect se già loggato
if(localStorage.getItem("token")){
  window.location.href="dashboard.html";
}

// Inizializza Icone Lucide
lucide.createIcons();

// Animazione Background Resistenze
const resistors = document.querySelectorAll('.resistor-img');
const items = [];

resistors.forEach((el, index) => {
  // Grandezze "giganti" casuali tra 350px e 650px
  let width = 350 + Math.random() * 300;
  let height = width * 0.35;

  el.style.width = width + 'px';
  el.style.filter = `hue-rotate(${index * 45}deg)`; // Colori diversi

  items.push({
    el: el,
    x: Math.random() * window.innerWidth,
    y: Math.random() * window.innerHeight,
    vx: (Math.random() > 0.5 ? 1 : -1) * (0.3 + Math.random() * 0.6),
    vy: (Math.random() > 0.5 ? 1 : -1) * (0.3 + Math.random() * 0.6),
    rot: Math.random() * 360,
    vrot: (Math.random() - 0.5) * 0.4,
    w: width,
    h: height
  });
});

function animate() {
  const W = window.innerWidth;
  const H = window.innerHeight;

  items.forEach(item => {
    item.x += item.vx;
    item.y += item.vy;
    item.rot += item.vrot;

    // Rimbalzo fuori schermo
    if (item.x <= -item.w / 2) {
      item.vx = Math.abs(item.vx);
    } else if (item.x + item.w / 2 >= W) {
      item.vx = -Math.abs(item.vx);
    }

    if (item.y <= -item.h / 2) {
      item.vy = Math.abs(item.vy);
    } else if (item.y + item.h / 2 >= H) {
      item.vy = -Math.abs(item.vy);
    }

    item.el.style.transform = `translate3d(${item.x}px, ${item.y}px, 0) rotate(${item.rot}deg)`;
  });

  requestAnimationFrame(animate);
}

// Avvia animazione resistenze
animate();
</script>

